---
import { GITHUB_URL, SITE_AUTHOR } from '../consts';
import LowEffectsToggle from './LowEffectsToggle';
import ShinyLabel from './ShinyLabel';
---

<footer class="site-footer">
	<div class="wrap">
		<span>
			© {new Date().getFullYear()}{' '}
			<ShinyLabel client:visible text={SITE_AUTHOR} />
		</span>
		<LowEffectsToggle client:load />
		<a href={GITHUB_URL}>GitHub</a>
	</div>
</footer>
