---
import { NAV_ITEMS, isCurrent } from '../lib/nav';
import { stripBase, withBase } from '../lib/paths';
import ThemeToggle from './ThemeToggle';

interface Props {
	readingProgress?: boolean;
}

const { readingProgress = false } = Astro.props;
const path = stripBase(Astro.url.pathname);
---

<header class="site-header">
	<div class="wrap header-inner">
		<a class="brand" href={withBase('/')}>
			<span class="brand-mark">
				<img src={withBase('/apple-touch-icon.png')} alt="" width="28" height="28" />
			</span>
			<span class="brand-text">
				<span class="brand-name">阿萌的实验室</span>
				<span class="brand-sub">FIELD NOTES</span>
			</span>
		</a>
		<div class="header-end">
			<nav class="nav" aria-label="主导航">
				{
					NAV_ITEMS.map((item) => (
						<a href={withBase(item.href)} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>
			<ThemeToggle client:load />
		</div>
	</div>
	{
		readingProgress && (
			<div class="reading-progress" aria-hidden="true">
				<span class="reading-progress-bar" />
			</div>
		)
	}
</header>
