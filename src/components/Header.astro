---
const path = Astro.url.pathname;

function current(href: string) {
	if (href === '/') return path === '/';
	return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">
			<span class="brand-mark">萌</span>
			萌实验室
		</a>
		<nav class="nav" aria-label="主导航">
			<a href="/notes" aria-current={current('/notes') ? 'page' : undefined}>笔记</a>
			<a href="/projects" aria-current={current('/projects') ? 'page' : undefined}>作品</a>
			<a href="/about" aria-current={current('/about') ? 'page' : undefined}>关于</a>
		</nav>
	</div>
</header>
