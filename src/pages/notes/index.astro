---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import HeroHeading from '../../components/HeroHeading';
import HeroKicker from '../../components/HeroKicker';
import { getNotes } from '../../lib/content';

const notes = await getNotes();
---

<BaseLayout title="笔记" description="上线实录、Cloudflare、Agent 和全栈踩坑。">
	<HeroKicker client:visible text="Notes" />
	<h1 class="visually-hidden">笔记</h1>
	<HeroHeading client:visible className="page-title" text="笔记" />
	<p class="page-desc">记下一些实际遇到的问题，以及我的心得体会。</p>
	<div class="section" id="recent-notes">
		<NoteList notes={notes} />
	</div>
</BaseLayout>
