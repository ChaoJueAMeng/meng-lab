---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import ProjectList from '../components/ProjectList.astro';
import HeroHeading from '../components/HeroHeading';
import HeroKicker from '../components/HeroKicker';
import ShinyLabel from '../components/ShinyLabel';
import { getNotes, getProjects } from '../lib/content';
import { withBase } from '../lib/paths';

const notes = (await getNotes()).slice(0, 3);
const projects = (await getProjects()).slice(0, 5);
---

<BaseLayout>
	<section class="hero">
		<HeroKicker client:visible text="meng-lab" />
		<h1 class="visually-hidden">把做过的事记下来。</h1>
		<HeroHeading client:visible text="把做过的事记下来。" />
		<p class="lede">
			阿萌的工程手记。外卖、聊天、小工具、Harness ——把过程、心得和踩过的坑都写在这里。
		</p>
	</section>

	<section class="section" id="works">
		<div class="section-head">
			<h2>作品</h2>
			<a class="more" href={withBase('/projects')}>
				<ShinyLabel client:visible text="全部作品" />
			</a>
		</div>
		<ProjectList projects={projects} />
	</section>

	<section class="section" id="recent-notes">
		<div class="section-head">
			<h2>最近笔记</h2>
			<a class="more" href={withBase('/notes')}>
				<ShinyLabel client:visible text="全部笔记" />
			</a>
		</div>
		<NoteList notes={notes} />
	</section>
</BaseLayout>
