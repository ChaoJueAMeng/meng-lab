---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getNotes, getProjects } from '../lib/content';

const notes = (await getNotes()).slice(0, 3);
const projects = (await getProjects()).slice(0, 3);
---

<BaseLayout>
	<section class="hero">
		<p class="kicker">meng-lab</p>
		<h1>把能上线的东西写下来。</h1>
		<p class="lede">
			萌的工程手记。外卖、聊天、Agent、字幕流水线——先跑到公网上，再把踩过的坑记在这里。
		</p>
	</section>

	<section class="section">
		<div class="section-head">
			<h2>最近笔记</h2>
			<a class="more" href="/notes">全部笔记</a>
		</div>
		<NoteList notes={notes} />
	</section>

	<section class="section">
		<div class="section-head">
			<h2>作品</h2>
			<a class="more" href="/projects">全部作品</a>
		</div>
		<ProjectList projects={projects} />
	</section>
</BaseLayout>
