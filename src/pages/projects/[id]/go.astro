---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects } from '../../../lib/content';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const href = project.data.href;
const readme = project.data.readme;
const back = withBase('/projects');
---

<BaseLayout
	title={readme ? `${project.data.title} · README` : project.data.title}
	description={project.data.summary}
	noindex
>
	<article class="transit">
		<p class="kicker">{readme ? 'README' : '说明'}</p>
		<h1 class="page-title">
			{project.data.title}
			<span class="project-status">{project.data.status}</span>
		</h1>
		<p class="page-desc">{project.data.summary}</p>
		{
			readme === 'private' ? (
				<p class="transit-source">仓库没有公开。下面是 README 摘录。</p>
			) : readme ? (
				<p class="transit-source">
					摘自仓库 README ·
					<a href={readme} target="_blank" rel="noopener">
						在 GitHub 打开
					</a>
				</p>
			) : (
				<p class="transit-source">这个作品没有公开 README。下面是说明，不会跳到外部地址。</p>
			)
		}
		<div class="prose">
			<Content />
		</div>
		{
			href ? (
				<div class="transit-actions">
					<p class="transit-url">
						原地址
						<a href={href} target="_blank" rel="noopener">
							{href}
						</a>
					</p>
					<a class="transit-cta" href={href} target="_blank" rel="noopener">
						前往原地址
					</a>
				</div>
			) : (
				<p class="transit-missing">这个作品没有公开地址。</p>
			)
		}
		<p>
			<a class="transit-back" href={back}>返回</a>
		</p>
	</article>
</BaseLayout>
