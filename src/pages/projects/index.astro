---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();

const tokenCounts = new Map<string, number>();
for (const project of projects) {
	tokenCounts.set(project.data.status, (tokenCounts.get(project.data.status) ?? 0) + 1);
	for (const tech of project.data.stack) {
		tokenCounts.set(tech, (tokenCounts.get(tech) ?? 0) + 1);
	}
}

const statusOrder = ['已上线', '公开仓库', '实验中', '自用工具'].filter((s) => tokenCounts.has(s));
const stackItems = [...tokenCounts.entries()]
	.filter(([key]) => !statusOrder.includes(key))
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'))
	.map(([key]) => key);

const filters = [...statusOrder, ...stackItems];
---

<BaseLayout title="作品档案" description="已部署上线、公开开源或正在打磨的真实工程项目。">
	<header class="archive-header">
		<p class="journal-kicker">
			<span class="kicker-stamp">ARCHIVE · 01</span>
			<span class="kicker-sep">/</span>
			<span>PROJECTS</span>
		</p>
		<h1 class="page-title">作品档案</h1>
		<p class="page-desc">能访问、能安装的真实项目。虽然中间翻过不少车，但每个都跑通了闭环。</p>

		<div class="filter-bar" role="toolbar" aria-label="按状态或技术栈筛选项目" data-filter-root="projects">
			<button type="button" class="filter-pill is-active" data-filter-btn="" aria-pressed="true">
				全部
				<span class="filter-count">{projects.length}</span>
			</button>
			{
				filters.map((token) => (
					<button type="button" class="filter-pill" data-filter-btn={token} aria-pressed="false">
						{token}
						<span class="filter-count">{tokenCounts.get(token)}</span>
					</button>
				))
			}
		</div>
	</header>

	<div class="section archive-body" id="works" data-filter-scope="projects">
		<ProjectList projects={projects} bento />
		<div class="filter-empty" hidden>
			<p>没有匹配当前筛选条件的项目。</p>
			<button type="button" class="btn-paper" data-filter-reset>显示全部项目</button>
		</div>
	</div>
</BaseLayout>

<script>
	function setupProjectFilter() {
		const bar = document.querySelector<HTMLElement>('[data-filter-root="projects"]');
		const scope = document.querySelector<HTMLElement>('[data-filter-scope="projects"]');
		if (!bar || !scope || bar.dataset.bound === 'true') return;
		bar.dataset.bound = 'true';

		const list = scope.querySelector<HTMLElement>('.project-list');
		const cells = Array.from(scope.querySelectorAll<HTMLElement>('.project-cell'));
		const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
		const empty = scope.querySelector<HTMLElement>('.filter-empty');
		const resetBtn = scope.querySelector<HTMLButtonElement>('[data-filter-reset]');

		const apply = (tag: string, pushUrl = true) => {
			const clean = tag.trim();
			let shown = 0;

			cells.forEach((cell) => {
				const tokens = (cell.dataset.tokens ?? '').split('|').filter(Boolean);
				const match = !clean || tokens.includes(clean);
				cell.hidden = !match;
				if (match) shown++;
			});

			list?.classList.toggle('is-filtered', Boolean(clean));
			if (empty) empty.hidden = shown > 0;

			buttons.forEach((btn) => {
				const active = (btn.dataset.filterBtn ?? '') === clean;
				btn.classList.toggle('is-active', active);
				btn.setAttribute('aria-pressed', String(active));
				if (active && pushUrl) {
					btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
				}
			});

			if (pushUrl) {
				const url = new URL(window.location.href);
				if (clean) url.searchParams.set('tag', clean);
				else url.searchParams.delete('tag');
				window.history.replaceState({}, '', url);
			}
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => apply(btn.dataset.filterBtn ?? ''));
		});

		scope.querySelectorAll<HTMLAnchorElement>('[data-tag-trigger]').forEach((chip) => {
			chip.addEventListener('click', (event) => {
				event.preventDefault();
				apply(chip.dataset.tagTrigger ?? '');
			});
		});

		resetBtn?.addEventListener('click', () => apply(''));

		const initial = new URLSearchParams(window.location.search).get('tag') ?? '';
		if (initial) apply(initial, false);
	}

	document.addEventListener('astro:page-load', setupProjectFilter);
</script>
